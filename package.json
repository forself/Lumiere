    "check:designer-autojoin": "node tests/designer-autojoin.mjs",
    "check:designer-dxf": "node tests/designer-dxf.mjs",
    "check:designer-advanced": "node tests/designer-advanced.mjs",
    "check:designer-frame": "node tests/designer-frame.mjs",
