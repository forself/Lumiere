    "check:designer-device-links": "node tests/designer-device-links.mjs",
    "check:designer-media": "node tests/designer-media.mjs",
    "check:designer-media-runtime": "node tests/designer-media-runtime.mjs",
    "check:designer-floors": "node tests/designer-floors.mjs",
    "check:designer-stairs": "node tests/designer-stairs.mjs",
    "check:designer-elevators": "node tests/designer-elevators.mjs",
