    "check:designer-stair-walls": "node tests/designer-stair-walls.mjs",
    "check:designer-stair-motion": "node tests/designer-stair-motion.mjs",
    "check:designer-glass-doors": "node tests/designer-glass-doors.mjs",
    "check:designer-tatami": "node tests/designer-tatami.mjs",
    "check:designer-zones": "node tests/designer-zones.mjs",
    "check:designer-standard-floors": "node tests/designer-standard-floors.mjs",
    "check:designer-shafts": "node tests/designer-shafts.mjs",
    "check:designer-context": "node tests/designer-context.mjs",
    "check:designer-batch": "node tests/designer-batch.mjs",
    "check:designer-polygon": "node tests/designer-polygon.mjs",
    "check:designer-drafting": "node tests/designer-drafting.mjs",
    "check:designer-elements": "node tests/designer-elements.mjs",
    "check:designer-drawings": "node tests/designer-drawings.mjs",
